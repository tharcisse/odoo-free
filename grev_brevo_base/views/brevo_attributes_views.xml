<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="grev_brevo_attribute_view_tree" model="ir.ui.view">
        <field name="name">grev_brevo_attribute.view.tree</field>
        <field name="model">grev.brevo.attribute</field>
        <field name="arch" type="xml">
            <list editable="bottom">
                <field name="name" />
                <field name="odoo_model_id" />
                <field name="odoo_map_id" domain="[('model_id','=',odoo_model_id)]" />
                <button invisible="brevoid" string="Send to Brevo" name="action_sync_odoo_2_brevo"
                    type="object" class="oe_highlight" />
                <button invisible="not brevoid" string="Update Brevo"
                    name="action_sync_odoo_2_brevo" type="object" class="oe_highlight" />
            </list>
        </field>
    </record>
    <record id="grev_brevo_attributes_action" model="ir.actions.act_window">
        <field name="name">Attributes</field>
        <field name="res_model">grev.brevo.attribute</field>
        <field name="view_mode">list</field>
        <field name="domain" eval="[('odoo_model_id','=',ref('base.model_res_partner'))]"/>
        <field name="context" eval="{'default_odoo_model_id':ref('base.model_res_partner')}"/>
    </record>
</odoo>