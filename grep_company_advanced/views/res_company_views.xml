<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="res_company_view_form" model="ir.ui.view">
        <field name="name">res_company.view.form</field>
        <field name="model">res.company</field>
        <field name="inherit_id" ref="base.view_company_form" />
        <field name="arch" type="xml">
            <xpath expr="//field[@name='vat']" position="before">
                <field name="industry_id" />
                <field name="legal_classification" />
                <field name="license_number" />
                <field name="license_valid_until" />
            </xpath>
            <xpath expr="//page[@name='general_info']" position="inside">
                <group name="description" string="Description">
                    <field name="description" nolabel="1" />
                </group>
            </xpath>
            <xpath expr="//page[last()]" position="after">
                <page name="company_shares" string="Shares info">
                    <group>
                        <group>
                            <field name="total_shares" />
                        </group>
                        <group>
                        </group>
                    </group>
                    <group name="shareholders" string="Shareholders">
                        <field name="shareholder_ids" nolabel="1">
                            <list editable="bottom">
                                <field name="company_id" column_invisible="1" />
                                <field name="partner_id" required="1" />
                                <field name="shares" />
                                <field name="ratio" />
                            </list>
                        </field>
                    </group>
                </page>
            </xpath>
        </field>
    </record>
</odoo>